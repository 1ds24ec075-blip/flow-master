{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pskuxhpfohmxlhmupeoz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "talligence-mcp",
      "version": "1.0.0",
      "title": "Talligence MCP"
    },
    "tools": [
      {
        "name": "get_system_summary",
        "title": "System summary",
        "description": "Get counts across the main business entities (clients, suppliers, invoices, POs, bills, bank statements, inventory).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_clients",
        "title": "Get clients",
        "description": "List or search clients. Optionally fetch a single client by ID.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "description": "Fetch a single client by UUID."
            },
            "search": {
              "type": "string",
              "description": "Case-insensitive name search."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_suppliers",
        "title": "Get suppliers",
        "description": "List or search suppliers. Optionally fetch a single supplier by ID.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "supplier_id": {
              "type": "string"
            },
            "search": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_invoices",
        "title": "Get invoices",
        "description": "Fetch client or raw-material invoices with optional status filter.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "invoice_type": {
              "type": "string",
              "enum": [
                "client",
                "raw_material"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "awaiting_approval",
                "approved",
                "rejected",
                "all"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "invoice_type"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_bills",
        "title": "Get bills",
        "description": "List bills (extracted from Gmail/uploads).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Optional bill status filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_inventory_status",
        "title": "Inventory status",
        "description": "List inventory items, optionally filtered to low-stock items only.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "low_stock_only": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_purchase_orders",
        "title": "Get purchase orders",
        "description": "List purchase orders from the PO intake pipeline.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_approvals",
        "title": "Get approvals",
        "description": "List approval requests.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected",
                "all"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_approval_status",
        "title": "Approve or reject",
        "description": "Approve or reject a pending approval request.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "approval_id": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "comment": {
              "type": "string"
            }
          },
          "required": [
            "approval_id",
            "action"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_reorder_request",
        "title": "Create reorder request",
        "description": "Create a reorder request for a low-stock inventory item.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "inventory_item_id": {
              "type": "string"
            },
            "quantity": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "supplier_id": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "inventory_item_id",
            "quantity"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
