# Frontend Supabase connection (read at build time by vite.config.ts).
# Copy this file to `.env` and fill in YOUR project's values.
# Find these in Supabase Dashboard -> Project Settings -> API.
#
# On a host (Vercel/Netlify/Cloudflare Pages) set these as build-time
# environment variables instead of committing a .env file.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"
