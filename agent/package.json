{
  "name": "reconza-tally-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local sync agent that pushes Reconza vouchers into Tally over its HTTP-XML interface.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning src/cli.ts setup",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "once": "node --disable-warning=ExperimentalWarning src/cli.ts flush",
    "doctor": "node --disable-warning=ExperimentalWarning src/cli.ts doctor",
    "build": "node build.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test src/*.test.ts"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
